<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="quantm_bg">#121212</color>

    <style name="Theme.Quantm" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/quantm_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Quantm.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/quantm_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Quantm</item>
    </style>
</resources>
